{
  "name": "sitpa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "vite --host 127.0.0.1",
    "local": "node tools/local-dev.mjs",
    "prepare:hardware": "node tools/prepare-hardware.mjs",
    "check:hardware": "node tools/check-hardware.mjs",
    "verify:hardware": "node tools/verify-hardware.mjs",
    "hardware": "node tools/hardware-local.mjs",
    "build": "node tools/build-sites.mjs",
    "build:github": "vite build --outDir _site --emptyOutDir",
    "sync:rivers": "node tools/sync-peru-rivers.mjs",
    "test": "node --test tests/*.test.mjs",
    "backend": "npm start --workspace backend",
    "broker": "node tools/local-broker.mjs",
    "simulate": "node tools/simulate-station.mjs",
    "test:integration": "node --test tests/integration.test.mjs"
  },
  "devDependencies": {
    "aedes": "^1.2.0",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "backend"
  ],
  "dependencies": {
    "echarts": "^6.1.0"
  }
}
